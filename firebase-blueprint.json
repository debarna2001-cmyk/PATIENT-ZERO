{
  "entities": {
    "UserStats": {
      "title": "UserStats",
      "description": "User overall stats",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "targetSpecialty": { "type": "string" },
        "targetExamYear": { "type": "number" },
        "daysToExam": { "type": "number" },
        "patientHealth": { "type": "number" },
        "burnoutIndex": { "type": "number" },
        "isStabilizing": { "type": "boolean" },
        "shiftStreak": { "type": "number" },
        "patientsSaved": { "type": "number" },
        "patientsFlatlined": { "type": "number" },
        "unlockedPearlsCount": { "type": "number" },
        "xp": { "type": "number" },
        "credits": { "type": "number" },
        "streakShields": { "type": "number" },
        "customMilestones": { "type": "array" },
        "redeemedRewards": { "type": "array" },
        "restorativeHistory": { "type": "array" }
      },
      "required": ["studentName", "targetSpecialty", "targetExamYear", "daysToExam", "patientHealth", "burnoutIndex", "isStabilizing", "shiftStreak", "patientsSaved", "patientsFlatlined", "unlockedPearlsCount", "xp", "credits"]
    },
    "UserMissions": {
       "title": "UserMissions",
       "description": "User missions data",
       "type": "object",
       "properties": {
           "missionsTarget": { "type": "string" }
       }
    },
    "DailyMissionRecord": {
      "title": "DailyMissionRecord",
      "description": "Historical log of daily mission completion",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "completedCount": { "type": "number" },
        "totalCount": { "type": "number" },
        "completedRate": { "type": "number" },
        "archivedAt": { "type": "string" }
      },
      "required": ["date", "completedCount", "totalCount", "completedRate", "archivedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserStats" },
      "description": "User's main statistics document"
    },
    "users/{userId}/missions/{missionId}": {
       "schema": { "$ref": "#/entities/UserMissions" },
       "description": "Missions list"
    },
    "users/{userId}/mission_history/{historyId}": {
      "schema": { "$ref": "#/entities/DailyMissionRecord" },
      "description": "Historical archive of daily mission completion"
    }
  }
}
